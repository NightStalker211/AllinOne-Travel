{
  "name": "allinone-travel",
  "version": "1.0.0",
  "description": "AllinOne Travel — multi-modal travel planner with honest, live-only pricing: live flight fares, deep-link price checks for rail/bus/ferry, a unified country Explore hub, and a trip builder.",
  "author": {
    "name": "AllinOne Travel"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "desktop": "concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "npm run build && electron-builder --config electron-builder.yml",
    "desktop:preview": "npm run build && electron . --force-prod",
    "desktop:force-prod": "npm run build && electron . --force-prod",
    "screenshot": "tsx scripts/screenshot.ts",
    "gate:data": "tsx scripts/gate-data.ts",
    "gate:curated": "tsx scripts/gate-curated.ts",
    "gate:honesty": "tsx scripts/gate-honesty.ts",
    "gate:search": "tsx scripts/gate-search.ts",
    "gate:explore": "tsx scripts/gate-explore.ts",
    "verify": "npm run typecheck && npm run lint && npm run gate:data && npm run gate:curated && npm run build && npm run gate:honesty && npm run gate:search && npm run gate:explore",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.38.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "serve-handler": "^6.1.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "d3-geo": "^3.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
