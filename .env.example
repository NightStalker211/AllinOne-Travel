# ============================================================
# AllinOne Travel — Environment Configuration
# ============================================================
# Copy to .env.local (git-ignored) and fill in. NEXT_PUBLIC_* values
# are embedded into the static bundle at build time — rotate keys,
# never reuse them elsewhere, never commit .env.local.
# Status of every configured service: npm run check:apis
# ============================================================

# --- Live flight fares (rendered prices with source badge) ---
# Leave EMPTY to run with zero prices — the app shows honest
# "prices unavailable" states instead of numbers (never estimates).
# Test keys:  https://test.api.amadeus.com  (self-service workspace)
# Prod keys:   move to production in the Amadeus workspace, then set
#              NEXT_PUBLIC_AMADEUS_API_BASE_URL=https://api.amadeus.com
NEXT_PUBLIC_AMADEUS_API_KEY=
NEXT_PUBLIC_AMADEUS_API_SECRET=
NEXT_PUBLIC_AMADEUS_API_BASE_URL=https://test.api.amadeus.com

# Travelpayouts observed fares (used through the /api/tp proxy).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
NEXT_PUBLIC_TRAVELPAYOUTS_TOKEN=
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=

# --- Live hotel rates + route fare (RapidAPI, wired) ---
# Booking.com (Stays first) → Expedia (fallback); Skyscanner
# cheapest-fare card on the Flights tab. Monthly request quotas:
# Skyscanner 20, Expedia 15, Booking 50 (a spent quota renders the
# honest rate-limit note with no price; check:apis shows remaining).
NEXT_PUBLIC_RAPIDAPI_KEY=
NEXT_PUBLIC_RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_CURRENCY_HOST=currency-conversion-and-exchange-rates.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_GEODB_HOST=geodb-cities-graphql.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_TRAVEL_ADVISOR_HOST=travel-advisor.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_EXPEDIA_HOST=expedia-data1.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_SKYSCANNER_HOST=skyscanner-flights-api1.p.rapidapi.com
# Registered but NOT wired yet (see REBUILD §5.5 pending list):
# Expedia /flights/search answers 502 provider-side; Google Flights 404.
NEXT_PUBLIC_RAPIDAPI_GOOGLE_FLIGHTS_HOST=

# --- Weather (OpenWeather = fallback when Open-Meteo is down) ---
NEXT_PUBLIC_OPENWEATHER_KEY=

# --- Departures board (AviationStack, wired) ---
NEXT_PUBLIC_AVIATIONSTACK_KEY=

# --- Driving route chain (GraphHopper + OpenRouteService, wired) ---
NEXT_PUBLIC_GRAPHHOPPER_KEY=
NEXT_PUBLIC_OPENROUTESERVICE_KEY=

# --- London network status (Transport for London, wired) ---
NEXT_PUBLIC_TFL_PRIMARY_KEY=
NEXT_PUBLIC_TFL_SECONDARY_KEY=

# --- Registered but NOT wired yet (pending user-side fixes) ---
# OpenSky: 403 (credentials rejected) · Hotelbeds: auth scheme unresolved
# Deutsche Bahn: app not registered to the Timetables product
# AirLabs: free plan ignores the iata filter (full 23k dump)
# MakCrops: host/module unknown
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
HOTELBEDS_HOTEL_KEY=
HOTELBEDS_ACTIVITIES_KEY=
HOTELBEDS_TRANSFERS_KEY=
HOTELBEDS_SECRET=
AIRLABS_KEY=
DB_CLIENT_ID=
DB_API_KEY=
MAKCROPS_KEY=
